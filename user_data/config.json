{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "bot_name": "Automobot",
    "trading_mode": "spot",
    "dry_run": true,
    "dry_run_wallet": 10.0,
    "stake_currency": "USDT",
    "stake_amount": 5.0,
    "tradable_balance_ratio": 0.99,
    "max_open_trades": 1,
    "timeframe": "5m",
    "strategy": "AutomobotStrategy",
    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
        "ccxt_config": {},
        "ccxt_async_config": {},
        "pair_whitelist": [
            "BTC/USDT"
        ],
        "pair_blacklist": []
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exit_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },
    "order_types": {
        "entry": "limit",
        "exit": "limit",
        "stoploss": "market",
        "stoploss_on_exchange": false
    },
    "db_url": "sqlite:///user_data/tradesv3.dryrun.sqlite",
    "internals": {
        "process_throttle_secs": 5
    }
}
